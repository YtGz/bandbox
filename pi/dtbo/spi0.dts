/*
 * Enable SPI0 on the BCM2837 (Pi Zero 2 W) for use with the Waveshare
 * 2.13" e-ink display.
 *
 * Arch Linux ARM aarch64 ships upstream Linux DTBs, which leave the SPI
 * controller disabled and — unlike Raspberry Pi OS's vendor DTBs — provide
 * no `dtparam=spi=on`-style hook to enable it from config.txt. This
 * overlay does the equivalent: enables the controller, muxes the SPI data
 * pins (MOSI/MISO/SCLK), declares CE0/CE1 as GPIO chip-selects so the
 * driver can assert/deassert them properly, and exposes /dev/spidev0.0 and
 * /dev/spidev0.1 via the userspace `spidev` driver.
 *
 * Apply with:
 *   dtc -@ -I dts -O dtb -o spi0.dtbo spi0.dts
 *   fdtoverlay -i <base>.dtb -o <merged>.dtb spi0.dtbo
 *
 * The base DTB must have been built with -@ (symbols). The upstream
 * BCM283x DTBs shipped by Arch are. Verify with:
 *   ls /proc/device-tree/__symbols__/
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2837";

	/*
	 * Upstream Linux's BCM283x DTB has a `gpio@7e200000/alt0` hog node
	 * that statically pre-claims GPIOs 4, 5, 7, 8, 9, 10, 11 in ALT0
	 * mode at boot. The parent gpio controller's `pinctrl-0` references
	 * the hog by phandle, so simply setting status="disabled" on the
	 * hog has no effect (pinctrl hogs ignore status). The SPI driver
	 * then can't grab GPIOs 7-11 ("pin already requested by
	 * 3f200000.gpio") and probe fails.
	 *
	 * Shrink the hog's `brcm,pins` list down to {4, 5} so it stops
	 * claiming the SPI pins. We can't *remove* pins from a property in
	 * an overlay — only replace it whole — so just rewrite the array.
	 */
	fragment@0 {
		target-path = "/soc/gpio@7e200000/alt0";
		__overlay__ {
			brcm,pins = <4 5>;
		};
	};

	/*
	 * The upstream DTB defines `spi0_gpio7` as a pinctrl group for all
	 * five SPI pins (7, 8, 9, 10, 11) in ALT0 mode. If we reference
	 * that group for the controller's pinctrl-0 *and* add cs-gpios, the
	 * kernel sees a double-claim on 7 & 8 (both pinctrl alt0 function
	 * and gpio chip-select) and the SPI probe fails.
	 *
	 * Fix: define our own `spi0_pins` pinctrl group that only muxes the
	 * data/clock pins (9=MISO, 10=MOSI, 11=SCLK) into ALT0.  Pins 7 &
	 * 8 stay in their default GPIO state and are driven by the SPI
	 * driver via cs-gpios, which correctly toggles CE0 between frames.
	 */
	fragment@1 {
		target = <&gpio>;
		__overlay__ {
			spi0_pins: spi0_pins {
				brcm,pins = <9 10 11>;
				brcm,function = <4>;  /* BCM2835_FSEL_ALT0 */
			};
		};
	};

	fragment@2 {
		target-path = "/soc/spi@7e204000";
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&spi0_pins>;
			cs-gpios = <&gpio 8 1>, <&gpio 7 1>;
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * "spidev" as a DT compatible triggers a kernel
			 * warning ("buggy DT: spidev listed directly in DT").
			 * Use the rohm,dh2228fv shim that the official
			 * Raspberry Pi spi0 overlay also uses — the spidev
			 * driver matches this compatible without complaining.
			 */
			spidev@0 {
				compatible = "rohm,dh2228fv";
				reg = <0>;
				spi-max-frequency = <125000000>;
			};

			spidev@1 {
				compatible = "rohm,dh2228fv";
				reg = <1>;
				spi-max-frequency = <125000000>;
			};
		};
	};
};
